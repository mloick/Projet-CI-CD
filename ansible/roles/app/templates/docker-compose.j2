version: '3.8'
services:
  app:
    image: "{{ app_image }}:{{ app_tag }}"
    container_name: "{{ app_container_name }}"
    ports:
      - "{{ app_port }}:3000"
    environment:
      - NODE_ENV={{ app_env }}
      - PORT=3000
      - DATABASE_PATH=/app/data/calorie-tracker.db
      - LOG_LEVEL={{ app_log_level }}
    volumes:
      - "{{ app_data_volume }}:/app/data"
    networks:
      - "{{ app_network }}"
    restart: always

networks:
  {{ app_network }}:
    driver: bridge

volumes:
  {{ app_data_volume }}:
